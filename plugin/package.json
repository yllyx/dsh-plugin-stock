{
  "name": "dsh-plugin-stock",
  "version": "0.3.4",
  "description": "DSH 股票交易体系助手 - 大盘择时(跌无可跌+企稳信号)、情绪与风格判定(抱团vs妖股)、板块监控与龙头候选、仓位体检、移动/阶梯止盈止损预警、全市场选股、K线（自动管理 Python 后端，仅监控建议，不做交易）",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh.plugin.json": "./dsh.plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "backend/*.py",
    "backend/requirements.txt",
    "backend/launch.bat",
    "backend/launch.sh",
    "backend/config.example.json",
    "backend/static/*",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "PUBLISHING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "release": "node publish.js",
    "release:dry": "node publish.js",
    "release:patch": "node publish.js --bump patch --publish",
    "release:minor": "node publish.js --bump minor --publish",
    "release:major": "node publish.js --bump major --publish",
    "publish-and-submit": "node publish-and-submit.js",
    "submit-marketplace": "node publish-and-submit.js",
    "test": "node test_apply.js && node test_backend.js",
    "test:apply": "node test_apply.js",
    "test:backend": "node test_backend.js",
    "pack": "npm pack"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cordis",
    "stock",
    "china-stock",
    "a-share",
    "pytdx",
    "monitoring",
    "kline"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yllyx/dsh-plugin-stock.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/yllyx/dsh-plugin-stock/issues"
  },
  "homepage": "https://github.com/yllyx/dsh-plugin-stock#readme",
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.7"
  }
}
